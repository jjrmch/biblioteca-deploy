# Copia este archivo a .env y rellena los valores reales.
# El archivo .env NO debe subirse al repositorio.
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambiar_por_una_clave_segura
POSTGRES_DB=biblioteca

DB_USER=admin
DB_PASSWORD=cambiar_por_una_clave_segura

DB_URL_CATALOG=jdbc:postgresql://postgres:5432/biblioteca
DB_URL_TRANSACTIONS=jdbc:postgresql://postgres:5432/transacciones
DB_URL_CUSTOMER=jdbc:postgresql://postgres:5432/clientes
DB_URL_AUTH=jdbc:postgresql://postgres:5432/auth

EUREKA_URL=http://discovery-service:8761/eureka/

# --- Seguridad (JWT) ---
# Secreto compartido por auth-service, gateway, catalog, customer y transactions.
# Mínimo 32 caracteres. Genera uno propio (por ejemplo: openssl rand -base64 32).
JWT_SECRET=cambiar_por_un_secreto_aleatorio_de_32_caracteres_minimo

# Usuario ADMIN que auth-service crea al arrancar si no existe
ADMIN_EMAIL=admin@biblioteca.com
ADMIN_PASSWORD=cambiar_por_una_clave_segura